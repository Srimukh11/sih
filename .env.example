# FaultEye Configuration
# Copy this file to .env and adjust values for your deployment

# ═══════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════
DATABASE_URL=postgresql://faulteye_user:faulteye_secure_2024@localhost:5432/faulteye

# ═══════════════════════════════════════════════════════════
# MQTT CONFIGURATION (ESP32 Communication)
# ═══════════════════════════════════════════════════════════
MQTT_BROKER=192.168.29.86
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=faulteye

# ═══════════════════════════════════════════════════════════
# API CONFIGURATION
# ═══════════════════════════════════════════════════════════
API_HOST=0.0.0.0
API_PORT=8000

# ═══════════════════════════════════════════════════════════
# OPENAI/AI CONFIGURATION
# ═══════════════════════════════════════════════════════════
OPENAI_API_KEY=your_openai_api_key_here
AI_MAX_ACTIONS=5
AI_MAX_WORDS_PER_ACTION=12
AI_MAX_SUMMARY_WORDS=15

# ═══════════════════════════════════════════════════════════
# ML CONFIGURATION
# ═══════════════════════════════════════════════════════════
ANOMALY_THRESHOLD=0.7
MODEL_UPDATE_INTERVAL=3600

# ═══════════════════════════════════════════════════════════
# ALERT CONFIGURATION
# ═══════════════════════════════════════════════════════════
ENABLE_EMAIL=true
ENABLE_SMS=false
ALERT_EMAIL=alerts@yourcompany.com
EMERGENCY_PHONE=+1234567890

# ═══════════════════════════════════════════════════════════
# DATA RETENTION (days)
# ═══════════════════════════════════════════════════════════
RAW_DATA_RETENTION_DAYS=90
AGGREGATED_DATA_RETENTION_DAYS=365

# ═══════════════════════════════════════════════════════════
# SENSOR THRESHOLDS - WATER LINE
# ═══════════════════════════════════════════════════════════
THRESHOLD_FLOW_MIN=1.0
THRESHOLD_FLOW_MAX=4.0
THRESHOLD_FLOW_NORMAL=2.5

THRESHOLD_WATER_LEVEL_MIN=1
THRESHOLD_WATER_LEVEL_MAX=1
THRESHOLD_WATER_LEVEL_NORMAL=1

THRESHOLD_TOTAL_LITRES_MIN=0
THRESHOLD_TOTAL_LITRES_MAX=10000

# ═══════════════════════════════════════════════════════════
# SENSOR THRESHOLDS - GAS LINE
# ═══════════════════════════════════════════════════════════
THRESHOLD_GAS_AO1_MIN=0
THRESHOLD_GAS_AO1_MAX=400
THRESHOLD_GAS_AO1_NORMAL=200
THRESHOLD_GAS_AO1_CRITICAL=3200

THRESHOLD_GAS_AO2_MIN=0
THRESHOLD_GAS_AO2_MAX=400
THRESHOLD_GAS_AO2_NORMAL=200
THRESHOLD_GAS_AO2_CRITICAL=3500

THRESHOLD_GAS_DO1_MIN=1
THRESHOLD_GAS_DO1_MAX=1
THRESHOLD_GAS_DO1_NORMAL=1

THRESHOLD_GAS_DO2_MIN=1
THRESHOLD_GAS_DO2_MAX=1
THRESHOLD_GAS_DO2_NORMAL=1

# ═══════════════════════════════════════════════════════════
# SENSOR THRESHOLDS - POWER LINE
# ═══════════════════════════════════════════════════════════
THRESHOLD_AC_MIN=0
THRESHOLD_AC_MAX=0
THRESHOLD_AC_NORMAL=0

# ═══════════════════════════════════════════════════════════
# SENSOR THRESHOLDS - FIBER/DATA CABLE
# ═══════════════════════════════════════════════════════════
THRESHOLD_LDR_RAW_MIN=300
THRESHOLD_LDR_RAW_MAX=4095
THRESHOLD_LDR_RAW_NORMAL=2000

THRESHOLD_LDR_VOLTAGE_MIN=0.5
THRESHOLD_LDR_VOLTAGE_MAX=3.3
THRESHOLD_LDR_VOLTAGE_NORMAL=1.6

# ═══════════════════════════════════════════════════════════
# SEVERITY CALCULATION RULES
# ═══════════════════════════════════════════════════════════
HIGH_DEVIATION_THRESHOLD=50.0
MEDIUM_DEVIATION_THRESHOLD=20.0
